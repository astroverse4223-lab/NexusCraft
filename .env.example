# Copy to .env.local or set these in your shell before running the launcher.
# Both are optional — everything can also be configured from inside the app.

# Azure application (client) ID used for Microsoft sign-in.
# This is a public identifier, not a secret. See "Configuring Microsoft
# authentication" in the README for how to create one.
# When set, it overrides whatever is saved in Settings → Sign-in.
NEXUSCRAFT_CLIENT_ID=

# Where instances, versions, libraries, assets and Java runtimes are stored.
# Defaults to %APPDATA%\nexuscraft-launcher\data
NEXUSCRAFT_DATA_DIR=
