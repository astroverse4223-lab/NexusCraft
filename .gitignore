node_modules/
out/
dist/
release/
# Any build output directory, however it is named — electron-builder gets
# pointed at release2/ and the like when the usual one is locked by another
# process, and none of it belongs in the repository.
release*/
*.log
.DS_Store
Thumbs.db

# Generated icon artefacts — run `node scripts/generate-icon.js` to rebuild them.
build/icon.ico
build/icon.png

# Local overrides
.env
.env.local

# Code signing material must never be committed.
*.pfx
*.p12

# The Fabric mod's build output.
#
# Loom keeps a decompiled Minecraft and its remapped jars under mod/.gradle —
# 85MB of generated cache, and some of its paths are long enough that `git add`
# fails outright on Windows with "Filename too long" rather than just being
# large. None of it is source; `gradle build` regenerates all of it.
mod/.gradle/
mod/build/
mod/run/

# The Paper plugin's build output.
#
# Same reasoning as the Fabric mod above: the compiled classes, the shaded jar
# and Gradle's own cache are all regenerated by `gradlew build`, and none of it
# is source. The plugin's Java under server/src is what matters.
server/.gradle/
server/build/
server/run/

# And Ember's. Note that 195 files under ember/build are already tracked from
# before this rule, and a gitignore does not untrack anything - this only stops
# new build output being added. Clearing the old ones is a deliberate
# `git rm --cached ember/build` when somebody wants the 11MB back.
ember/.gradle/
ember/build/
ember/run/
